<%- include('partials/header') %>
  <% const added = locals.added || []; %>
  <% const deleted = locals.deleted || []; %>
  <%
    let pageTitle;
    if (success && dryRun) pageTitle = 'Dry run successful';
    else if (success) pageTitle = 'Published';
    else pageTitle = `Something went wrong${dryRun ? ' (dry run)' : ''}`;
  %>
<%- include('partials/label-strip', { title: pageTitle }) %>
  <% if (success && dryRun) { %>
    <p>
      If this had been real, it would have published as version <strong><%= versionNumber %></strong>:
    </p>
    <ul>
      <% added.forEach((name) => { %><li>+ <%= name %></li><% }) %>
      <% deleted.forEach((name) => { %><li>&minus; <%= name %></li><% }) %>
    </ul>
    <p class="hint">Nothing was actually published to Thunderstore. See the isolated <code><%= branch %></code> branch on GitHub for the test commit.</p>
  <% } else if (success) { %>
    <p>The mixtape is now at version <strong><%= versionNumber %></strong>:</p>
    <ul>
      <% added.forEach((name) => { %><li>+ <%= name %></li><% }) %>
      <% deleted.forEach((name) => { %><li>&minus; <%= name %></li><% }) %>
    </ul>
    <p><a href="<%= thunderstoreUrl %>" target="_blank" rel="noopener">View on Thunderstore</a></p>
    <% if (locals.bookkeepingError) { %>
      <p class="warning">
        Published successfully — but something afterward (updating the track list or repo records) failed:
        <%= bookkeepingError %>. Thunderstore itself is unaffected; a maintainer may need to manually check R2/the manifest.
      </p>
    <% } %>
  <% } else { %>
    <p class="error"><%= error %></p>
  <% } %>
  <p><a href="/">Back to tracks</a></p>
<%- include('partials/footer') %>
