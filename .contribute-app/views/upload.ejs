<%- include('partials/header') %>
<%- include('partials/deck-bar') %>
  <h1>Queue a track</h1>
  <p class="subtitle">
    Logged in as <strong><%= displayName %></strong>
    &mdash;
    <a href="/tracks">view tracks &amp; publish</a>
    &mdash;
    <form method="POST" action="/logout" class="inline-form">
      <button type="submit" class="link-button">log out</button>
    </form>
  </p>
  <div class="info-panel">
    <p>Up to <%= maxTracks %> tracks total, each under <%= maxTrackFileSizeKb %>KB once converted.</p>
    <p class="hint">Queueing is fast and doesn't publish anything &mdash; review your changes and hit Publish from the tracks page whenever you're ready.</p>
  </div>
  <% if (error) { %>
    <p class="error" id="submit-error"><%= error %></p>
  <% } %>
  <p class="success" id="submit-success" hidden></p>
  <p class="lock-hint">Press &ldquo;Start editing&rdquo; above before queueing a track.</p>
  <form method="POST" action="/submit" enctype="multipart/form-data" id="upload-form" class="lock-gated">
    <label>
      Audio file
      <input type="file" name="audio" accept="audio/*" required>
    </label>
    <label>
      Song title
      <input type="text" name="title" required>
    </label>
    <label>
      Artist
      <input type="text" name="artist" required>
    </label>
    <button type="submit" id="submit-button">Add to queue</button>
  </form>
  <script>
    document.getElementById('upload-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const button = document.getElementById('submit-button');
      const errorEl = document.getElementById('submit-error');
      const successEl = document.getElementById('submit-success');
      if (errorEl) errorEl.remove();
      successEl.hidden = true;

      button.disabled = true;
      button.textContent = 'Queueing...';

      try {
        const response = await fetch('/submit', { method: 'POST', body: new FormData(form) });
        const data = await response.json();
        if (!response.ok) {
          throw new Error(data.error || 'Something went wrong.');
        }
        successEl.textContent = `Queued: ${data.trackName}`;
        successEl.hidden = false;
        form.reset();
      } catch (err) {
        const p = document.createElement('p');
        p.className = 'error';
        p.id = 'submit-error';
        p.textContent = err.message;
        form.insertAdjacentElement('beforebegin', p);
      } finally {
        button.disabled = false;
        button.textContent = 'Add to queue';
      }
    });
  </script>
<%- include('partials/footer') %>
