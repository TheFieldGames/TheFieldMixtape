<div class="label-strip">
  <div class="label-main">
    <h1><% if (locals.titleHref) { %><a href="<%= titleHref %>" target="_blank" rel="noopener"><%= title %></a><% } else { %><%= title %><% } %></h1>
    <% if (locals.subtitle) { %><p><%= subtitle %></p><% } %>
  </div>
  <% if (locals.sideLetter) { %>
    <div class="side-marker"><span class="box"><%= sideLetter %></span></div>
  <% } %>
</div>
