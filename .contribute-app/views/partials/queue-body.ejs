<div class="layout">
  <!-- Side A: the live tracklist, with inline removal marks -->
  <div class="container side-a">
    <div class="hubs"><div class="hub"></div><div class="hub"></div></div>
    <%- include('label-strip', {
      title: 'Tracks',
      subtitle: `${rows.length} live · ${pendingDeleteRows.length} marked for removal`,
      sideLetter: 'A',
    }) %>
    <p class="lock-hint">Press &ldquo;Start editing&rdquo; above to mark tracks for removal.</p>
    <% if (rows.length === 0) { %>
      <p class="hint">No tracks yet &mdash; queue one on Side B.</p>
    <% } else { %>
      <div class="table-toolbar">
        <span>Click <span style="color: var(--text-cream)">&times;</span> to mark a track for removal</span>
        <input type="text" id="track-filter" class="search" placeholder="Filter tracks&hellip;">
      </div>
      <div class="t-head"><span></span><span>Track</span><span>By</span><span>Added</span><span></span></div>
      <div class="scroll-wrap" data-scroll-fade>
        <div class="scroll-fade top"></div>
        <div class="no-scrollbar track-table-scroll" data-scroll-fade-body data-scroll-a>
          <% rows.forEach((row, i) => { %>
            <div class="t-row<%= row.pendingDelete ? ' removing' : '' %>" data-track-name="<%= row.trackName.toLowerCase() %>">
              <span class="t-num"><%= String(i + 1).padStart(2, '0') %></span>
              <span class="t-title"><%= row.trackName %></span>
              <span class="t-by<%= row.addedAt ? '' : ' legacy' %>"><%= row.addedBy %></span>
              <span class="t-date<%= row.addedAt ? '' : ' legacy' %>"><%= row.addedAt ? new Date(row.addedAt).toLocaleDateString() : 'legacy' %></span>
              <% if (row.pendingDelete) { %>
                <form method="POST" action="/tracks/undo-delete" class="inline-form pending-action-form lock-gated">
                  <input type="hidden" name="filename" value="<%= row.filename %>">
                  <button type="submit" class="t-action undo" title="Undo removal">&#8634;</button>
                </form>
              <% } else { %>
                <form method="POST" action="/tracks/delete" class="inline-form pending-action-form lock-gated">
                  <input type="hidden" name="filename" value="<%= row.filename %>">
                  <button type="submit" class="t-action" title="Mark for removal">&times;</button>
                </form>
              <% } %>
            </div>
          <% }) %>
        </div>
        <div class="scroll-fade bottom"></div>
      </div>
      <p class="table-footer"><%= rows.length %> track<%= rows.length === 1 ? '' : 's' %> on tape</p>
    <% } %>
  </div>

  <!-- Side B: everything pending this batch, both directions -->
  <div class="container side-b">
    <div class="hubs"><div class="hub"></div><div class="hub"></div></div>
    <%- include('label-strip', {
      title: 'Queue',
      subtitle: 'Everything pending this batch',
      sideLetter: 'B',
    }) %>
    <p class="lock-hint">Press &ldquo;Start editing&rdquo; above to add or remove tracks.</p>
    <div class="field">
      <div class="file-row lock-gated">
        <input type="file" id="file-picker" accept="audio/mpeg,.mp3" multiple>
      </div>
      <p class="hint" id="file-count">No files selected</p>
      <p class="file-helper">.mp3 only. Each file must convert to under <%= maxTrackFileSizeKb %>KB. Up to <%= maxTracks %> tracks total on the tape.</p>
    </div>
    <div class="staged-list" id="staged-list" hidden></div>
    <p class="error" id="add-queue-error"></p>
    <button type="button" id="add-to-queue-button" class="btn-secondary lock-gated" disabled>+ Add to queue</button>

    <div class="section-label"><span>Adding</span><span class="tag tag-pending"><%= pendingAddRows.length %></span></div>
    <% if (pendingAddRows.length === 0) { %>
      <p class="hint">Nothing queued to add.</p>
    <% } else { %>
      <div class="scroll-wrap" data-scroll-fade>
        <div class="scroll-fade top"></div>
        <div class="queue-scroll no-scrollbar" data-scroll-fade-body>
          <% pendingAddRows.forEach((row) => { %>
            <div class="queue-item" data-pending-add="<%= row.filename %>">
              <div class="qi-main">
                <div class="qi-title"><%= row.trackName %></div>
                <div class="qi-artist">queued by <%= row.addedBy %></div>
              </div>
              <form method="POST" action="/tracks/delete" class="inline-form pending-action-form lock-gated">
                <input type="hidden" name="filename" value="<%= row.filename %>">
                <button type="submit" class="qi-remove" title="Cancel this add">&times;</button>
              </form>
            </div>
          <% }) %>
        </div>
        <div class="scroll-fade bottom"></div>
      </div>
    <% } %>

    <div class="divider"></div>

    <div class="section-label"><span>Removing</span><span class="tag tag-removing"><%= pendingDeleteRows.length %></span></div>
    <% if (pendingDeleteRows.length === 0) { %>
      <p class="hint">Nothing marked for removal.</p>
    <% } else { %>
      <div class="scroll-wrap" data-scroll-fade>
        <div class="scroll-fade top"></div>
        <div class="queue-scroll no-scrollbar" data-scroll-fade-body>
          <% pendingDeleteRows.forEach((row) => { %>
            <div class="queue-item" data-pending-delete="<%= row.filename %>">
              <div class="qi-main">
                <div class="qi-title strike"><%= row.trackName %></div>
                <div class="qi-artist">added by <%= row.addedBy %></div>
              </div>
              <form method="POST" action="/tracks/undo-delete" class="inline-form pending-action-form lock-gated">
                <input type="hidden" name="filename" value="<%= row.filename %>">
                <button type="submit" class="qi-undo" title="Undo removal">&#8634;</button>
              </form>
            </div>
          <% }) %>
        </div>
        <div class="scroll-fade bottom"></div>
      </div>
    <% } %>
  </div>
</div>

<div class="batch-bar">
  <div class="batch-identity">
    <a href="<%= thunderstoreUrl %>" target="_blank" rel="noopener" class="batch-link">TheFieldMixtape &#8599;</a>
    <span class="batch-user"><%= displayName %><% if (isDemo) { %> <span class="tag tag-pending" title="Demo sessions can edit and queue changes, but Publish always runs as a dry run.">demo</span><% } %></span>
    <form method="POST" action="/logout" class="inline-form">
      <button type="submit" class="link-button batch-logout">log out</button>
    </form>
  </div>
  <% if (usageInfo) { %>
    <div class="batch-quota">
      <div class="batch-quota-track"><div class="batch-quota-fill<%= usageInfo.locked ? ' locked' : '' %>" style="width: <%= Math.min(100, (parseFloat(usageInfo.usageGB) / parseFloat(usageInfo.capGB)) * 100).toFixed(1) %>%"></div></div>
      <span class="batch-quota-text">
        <b><%= usageInfo.usageGB %></b>/<%= usageInfo.capGB %>GB this month
        <% if (usageInfo.locked) { %> &middot; locked<% } else if (usageInfo.publishesRemaining !== null) { %> &middot; ~<%= usageInfo.publishesRemaining %> publish<%= usageInfo.publishesRemaining === 1 ? '' : 'es' %> left<% } %>
      </span>
    </div>
  <% } %>
  <div class="batch-summary">
    <span class="add">+<%= pendingAddRows.length %> addition<%= pendingAddRows.length === 1 ? '' : 's' %></span>
    <span class="rem">&minus;<%= pendingDeleteRows.length %> removal<%= pendingDeleteRows.length === 1 ? '' : 's' %></span>
    <span class="muted">&rarr; <%= netAfterPublish %> track<%= netAfterPublish === 1 ? '' : 's' %> after publish</span>
  </div>
  <% if (isAdmin) { %>
    <label class="checkbox-label">
      <input type="checkbox" id="publish-dry-run">
      Dry run
    </label>
  <% } %>
  <button type="button" id="publish-button" class="lock-gated btn-primary" <%= pendingCount === 0 ? 'disabled' : '' %>>Publish <%= pendingCount %> change<%= pendingCount === 1 ? '' : 's' %></button>
  <button type="button" id="clear-batch-button" class="link-button lock-gated" <%= pendingCount === 0 ? 'disabled' : '' %>>Clear batch</button>
  <% if (pendingCount === 0) { %><p class="lock-hint" style="display: block;">Nothing queued yet &mdash; add a track or mark one for removal.</p><% } %>
  <p class="lock-hint">Press &ldquo;Start editing&rdquo; above before publishing.</p>
</div>
