<div class="deck-bar" id="deck-bar">
  <div class="deck-status">
    <span class="rec-dot" id="rec-dot"></span>
    <span id="deck-text">&nbsp;</span>
    <span class="deck-timer" id="deck-timer"></span>
  </div>
  <div class="deck-actions">
    <div class="idle-warning" id="idle-warning" hidden>
      <span>Still there? Editing stops soon from inactivity.</span>
      <button type="button" id="still-here-button" class="link-button">I&rsquo;m still here</button>
    </div>
    <button type="button" id="start-editing-button" class="link-button" hidden>Start editing</button>
    <button type="button" id="stop-editing-button" class="link-button" hidden>Stop editing</button>
  </div>
</div>
<script>window.INITIAL_LOCK_STATE = <%- JSON.stringify(lockState) %>;</script>
<script src="/lock-bar.js"></script>
