<%- include('partials/header', { layout: 'batch' }) %>
  <% if (error) { %>
    <p class="error top-bar"><%= error %></p>
  <% } else { %>
    <%- include('partials/deck-bar') %>

    <% const pendingCount = pendingAddRows.length + pendingDeleteRows.length; %>
    <% const netAfterPublish = rows.length - pendingDeleteRows.length + pendingAddRows.length; %>

    <div id="queue-body">
      <%- include('partials/queue-body', {
        rows, pendingAddRows, pendingDeleteRows, usageInfo, isAdmin, displayName, isDemo,
        maxTracks, maxTrackFileSizeKb, thunderstoreUrl, pendingCount, netAfterPublish,
      }) %>
    </div>

<%- include('partials/progress-modal') %>
    <script src="/scroll-fade.js"></script>
    <script>
      const queueBody = document.getElementById('queue-body');

      // ---------- Event delegation for everything inside #queue-body ----------
      // Every 10s poll (below) replaces #queue-body's innerHTML wholesale, so
      // any listener attached directly to an element inside it would go
      // stale the moment that element gets swapped out. Delegating to
      // #queue-body itself — which is never replaced, only its children —
      // means every handler here keeps working across any number of polls
      // without needing to be re-wired.

      // Counts requests still in flight from rapid-fire ×/undo clicks (each
      // one its own independent submit). Refreshing only runs once this
      // hits 0 — see refreshQueueBody's own comment below for why a
      // per-click refresh/reload was racy.
      let inFlightActions = 0;

      queueBody.addEventListener('submit', async (e) => {
        const form = e.target.closest('.pending-action-form');
        if (!form) return;
        e.preventDefault();
        const button = form.querySelector('button');
        button.disabled = true;
        inFlightActions++;
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(new FormData(form)),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Something went wrong.');
        } catch (err) {
          alert(err.message);
          button.disabled = false;
        } finally {
          inFlightActions--;
          if (inFlightActions === 0) refreshQueueBody();
        }
      });

      // ---------- Side A: live filter. No lock-gating — browsing/search
      // always works regardless of who (if anyone) holds the edit lock. ----------
      queueBody.addEventListener('input', (e) => {
        if (e.target.id !== 'track-filter') return;
        const q = e.target.value.trim().toLowerCase();
        const trackScroll = queueBody.querySelector('[data-scroll-a]');
        queueBody.querySelectorAll('.t-row').forEach((row) => {
          row.hidden = q.length > 0 && !row.dataset.trackName.includes(q);
        });
        if (trackScroll) trackScroll.dispatchEvent(new Event('scroll'));
      });

      // ---------- Side B: stage multiple files, one title/artist mini-form
      // each (guessed from the filename, editable), before queueing them
      // one at a time against the existing single-file /submit endpoint. ----------
      let staged = [];
      let stagedSeq = 0;

      function guessFromFilename(name) {
        const base = name.replace(/\.[^./]+$/, '');
        const sep = base.indexOf(' - ');
        if (sep === -1) return { title: base.trim(), artist: '' };
        return { title: base.slice(0, sep).trim(), artist: base.slice(sep + 3).trim() };
      }

      function renderStaged() {
        const stagedList = document.getElementById('staged-list');
        const fileCount = document.getElementById('file-count');
        const addToQueueButton = document.getElementById('add-to-queue-button');
        stagedList.innerHTML = '';
        staged.forEach((item) => {
          const row = document.createElement('div');
          row.className = 'staged-item';

          const fields = document.createElement('div');
          fields.className = 'staged-fields';

          const titleLabel = document.createElement('label');
          titleLabel.textContent = 'Title';
          const titleInput = document.createElement('input');
          titleInput.type = 'text';
          titleInput.className = 'staged-title';
          titleInput.value = item.guess.title;
          titleLabel.appendChild(titleInput);

          const artistLabel = document.createElement('label');
          artistLabel.textContent = 'Artist';
          const artistInput = document.createElement('input');
          artistInput.type = 'text';
          artistInput.className = 'staged-artist';
          artistInput.value = item.guess.artist;
          artistLabel.appendChild(artistInput);

          fields.appendChild(titleLabel);
          fields.appendChild(artistLabel);

          const removeButton = document.createElement('button');
          removeButton.type = 'button';
          removeButton.className = 'qi-remove staged-remove';
          removeButton.title = 'Remove from selection';
          removeButton.innerHTML = '&times;';
          removeButton.dataset.stagedId = item.id;

          row.appendChild(fields);
          row.appendChild(removeButton);
          stagedList.appendChild(row);
        });

        fileCount.textContent = staged.length === 0 ? 'No files selected' : `${staged.length} file${staged.length === 1 ? '' : 's'} selected`;
        stagedList.hidden = staged.length === 0;
        addToQueueButton.disabled = staged.length === 0;
      }

      queueBody.addEventListener('change', (e) => {
        if (e.target.id !== 'file-picker') return;
        const filePicker = e.target;
        const addQueueError = document.getElementById('add-queue-error');
        // Immediate client-side feedback only — the server (mp3FileFilter
        // in routes/index.js) is the real, authoritative check, since this
        // one is trivially bypassed by anyone not using the browser UI.
        const rejected = [];
        Array.from(filePicker.files).forEach((file) => {
          if (!/\.mp3$/i.test(file.name)) {
            rejected.push(file.name);
            return;
          }
          staged.push({ file, guess: guessFromFilename(file.name), id: ++stagedSeq });
        });
        if (rejected.length > 0) {
          addQueueError.textContent = `Only .mp3 files are accepted — skipped: ${rejected.join(', ')}`;
        }
        filePicker.value = '';
        renderStaged();
      });

      // Delegated separately from the submit/input handlers above since
      // staged-remove buttons are type="button" (no form to submit) and
      // are themselves recreated by renderStaged() on every change.
      queueBody.addEventListener('click', (e) => {
        const removeButton = e.target.closest('.staged-remove');
        if (!removeButton) return;
        const id = Number(removeButton.dataset.stagedId);
        staged = staged.filter((s) => s.id !== id);
        renderStaged();
      });

      queueBody.addEventListener('click', async (e) => {
        if (e.target.id !== 'add-to-queue-button') return;
        const addToQueueButton = e.target;
        const stagedList = document.getElementById('staged-list');
        const addQueueError = document.getElementById('add-queue-error');
        addQueueError.textContent = '';
        addToQueueButton.disabled = true;
        const rowEls = Array.from(stagedList.children);
        let stoppedAt = -1;

        for (let i = 0; i < staged.length; i++) {
          const item = staged[i];
          const rowEl = rowEls[i];
          const title = rowEl.querySelector('.staged-title').value.trim();
          const artist = rowEl.querySelector('.staged-artist').value.trim();
          addToQueueButton.textContent = `Queueing ${i + 1} of ${staged.length}…`;

          const formData = new FormData();
          formData.append('audio', item.file);
          formData.append('title', title);
          formData.append('artist', artist);

          try {
            const response = await fetch('/submit', { method: 'POST', body: formData });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Something went wrong.');
          } catch (err) {
            addQueueError.textContent = `"${item.file.name}": ${err.message}`;
            stoppedAt = i;
            break;
          }
        }

        addToQueueButton.textContent = '+ Add to queue';

        if (stoppedAt === -1) {
          window.location.reload();
          return;
        }

        // Partial failure: the ones before stoppedAt are safely queued
        // server-side already, so drop them locally. Keep the failed one
        // and everything after it staged (with their File objects still
        // intact) so they can be fixed and retried without re-choosing
        // files, which a browser can't do programmatically.
        staged = staged.slice(stoppedAt);
        renderStaged();
      });

      // ---------- Batch bar: Clear batch ----------
      queueBody.addEventListener('click', async (e) => {
        if (e.target.id !== 'clear-batch-button') return;
        const clearBatchButton = e.target;
        clearBatchButton.disabled = true;
        try {
          const pendingAdds = Array.from(queueBody.querySelectorAll('[data-pending-add]')).map((el) => el.dataset.pendingAdd);
          const pendingDeletes = Array.from(queueBody.querySelectorAll('[data-pending-delete]')).map((el) => el.dataset.pendingDelete);
          for (const filename of pendingAdds) {
            await fetch('/tracks/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams({ filename }),
            });
          }
          for (const filename of pendingDeletes) {
            await fetch('/tracks/undo-delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams({ filename }),
            });
          }
          window.location.reload();
        } catch (err) {
          alert(err.message);
          clearBatchButton.disabled = false;
        }
      });

      // ---------- Publish ----------
      queueBody.addEventListener('click', async (e) => {
        if (e.target.id !== 'publish-button') return;
        const publishButton = e.target;
        const dryRunCheckbox = document.getElementById('publish-dry-run');
        const isDryRun = dryRunCheckbox ? dryRunCheckbox.checked : false;
        const confirmMessage = isDryRun
          ? 'Run a dry-run publish? Nothing will actually go live.'
          : 'Publish all pending changes? This updates the live mixtape.';
        if (!confirm(confirmMessage)) return;

        publishButton.disabled = true;
        try {
          const response = await fetch('/tracks/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ dryRun: isDryRun ? 'on' : '' }),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Something went wrong.');
          openProgressModal({ jobId: data.jobId, dryRun: isDryRun });
        } catch (err) {
          alert(err.message);
          publishButton.disabled = false;
        }
      });

      // ---------- Keep .batch-layout's bottom padding in sync with the
      // fixed bar's actual rendered height, and re-wire the scroll-fade
      // gradients — both need to be redone against the new DOM every time
      // a poll (below) replaces #queue-body's contents, since a
      // ResizeObserver stops reporting once the element it was observing
      // is removed, and scroll-fade.js only auto-wires elements present at
      // the time its script runs. ----------
      let batchBarObserver = null;
      function wireQueueBody() {
        if (batchBarObserver) batchBarObserver.disconnect();
        const batchBar = queueBody.querySelector('.batch-bar');
        if (batchBar && window.ResizeObserver) {
          batchBarObserver = new ResizeObserver(() => {
            // getBoundingClientRect (not entry.contentRect, which excludes
            // padding/border) gives the bar's true outer height — exactly
            // what .batch-layout needs to clear.
            const height = batchBar.getBoundingClientRect().height;
            document.documentElement.style.setProperty('--batch-bar-height', `${height}px`);
          });
          batchBarObserver.observe(batchBar);
        }
        if (window.wireScrollFade) window.wireScrollFade(queueBody);
      }
      wireQueueBody();

      // ---------- Refreshing #queue-body in place from the true server
      // state — shared by the poll below and by every pending-action-form
      // submit (see that handler, wired earlier), instead of each doing
      // its own window.location.reload(). A plain per-form reload had a
      // real race: clicking × on two different rows in quick succession
      // fires two independent requests, and whichever one's response
      // lands first triggers an immediate reload — which can happen
      // *before* the second request has actually finished writing to R2,
      // showing a stale/undercounted queue until the next action catches
      // it up. Fetching this same fragment is always a fresh read, so as
      // long as it only runs once every currently in-flight action has
      // actually settled (see inFlightActions below), it can't observe a
      // partial/mid-write state the way a reload racing an in-flight
      // request could. ----------
      async function refreshQueueBody() {
        try {
          const response = await fetch('/tracks/queue-fragment');
          if (!response.ok) return;
          const html = await response.text();
          const filterValue = document.getElementById('track-filter')?.value ?? '';
          queueBody.innerHTML = html;
          wireQueueBody();
          const newFilterInput = document.getElementById('track-filter');
          if (newFilterInput && filterValue) {
            newFilterInput.value = filterValue;
            newFilterInput.dispatchEvent(new Event('input'));
          }
        } catch (err) {
          // Transient network hiccup — leave the current view as-is; the
          // next poll tick or action will pick it back up.
        }
      }

      // ---------- Live queue polling ----------
      // Every 10s, but only for a session that ISN'T the current editor —
      // the actual editor's own actions already refresh #queue-body on
      // success (see refreshQueueBody/inFlightActions), and polling out
      // from under someone actively filling in the staged-file mini-form
      // would wipe out unsaved input. This is exactly what let a real
      // change go unnoticed once already: one person queued removals,
      // released the lock, and the next editor's already-open tab never
      // refreshed to show them before publishing (the publish itself was
      // correct either way — processPublish always re-reads the manifest
      // fresh — but not being able to *see* the true state before
      // publishing is the real problem this fixes).
      const QUEUE_POLL_MS = 10000;
      setInterval(() => {
        if (document.body.dataset.lockState === 'you') return;
        refreshQueueBody();
      }, QUEUE_POLL_MS);
    </script>
  <% } %>
<%- include('partials/footer') %>
