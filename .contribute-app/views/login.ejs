<%- include('partials/header') %>
<%- include('partials/label-strip', { title: 'TheFieldMixtape', subtitle: 'Add a track to the mixtape', titleHref: thunderstoreUrl }) %>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>
  <form method="POST" action="/login">
    <label>
      Your name
      <input type="text" name="name" required maxlength="100" autocomplete="name">
    </label>
    <label>
      Mixtape Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit" class="btn-primary">Log in</button>
  </form>
  <form method="POST" action="/login/demo">
    <button type="submit" class="btn-secondary">Demo</button>
  </form>
  <script>
    // Render's free tier can take up to ~60s to wake from sleep — an
    // impatient re-click during that wait fires a second full login
    // request. Disabling on submit (not re-enabled — a fresh page load,
    // success or failure, handles that on its own) matches the same
    // double-submit guard every other form in the app already has.
    document.querySelectorAll('form').forEach((form) => {
      form.addEventListener('submit', () => {
        const button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        button.textContent = 'One moment…';
      });
    });
  </script>
<%- include('partials/footer') %>
