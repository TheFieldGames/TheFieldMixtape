# Copy to .env for local development. Never commit the real .env file.
# Run with `npm run dev` — it loads this file automatically via Node's
# built-in --env-file flag (no dotenv dependency needed).

PORT=3000

# bcrypt hash of the shared password (generate once with:
# node -e "console.log(require('bcryptjs').hashSync('your-password', 10))")
APP_PASSWORD_HASH=

# Optional: a second password that also logs a user in, but additionally
# flags the session as admin (unlocks the Dry Run option in the UI, both
# hidden from and rejected for non-admin sessions). Leave unset to disable
# the admin path entirely.
ADMIN_PASSWORD_HASH=

# Optional: posts a message to this Discord webhook URL every time someone
# logs in (real, admin, or demo). Leave unset to disable notifications
# entirely — a failed/unreachable webhook never blocks or fails a login
# either way. Create one via a Discord channel's Settings > Integrations >
# Webhooks > New Webhook.
DISCORD_WEBHOOK_URL=

# Random string for signing the session cookie.
SESSION_SECRET=

# Fine-grained GitHub PAT scoped to TheFieldGames/TheFieldMixtape, Contents: Read and write.
GITHUB_PAT=

GIT_REPO_URL=https://github.com/TheFieldGames/TheFieldMixtape.git

# Use a disposable branch during development so nothing hits main.
GIT_TARGET_BRANCH=contribute-app-test

# Thunderstore service-account token (tcli reads this env var natively).
TCLI_AUTH_TOKEN=

# Cloudflare R2 credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=thefieldmixtape-audio

# Path to the tcli binary. Set by the Dockerfile in production; override
# locally if you have tcli installed somewhere else.
TCLI_PATH=tcli

# Path to the ffmpeg binary, if not on PATH.
FFMPEG_PATH=ffmpeg

# Render's 5GB/month outbound bandwidth cap only meters traffic leaving
# Render's own servers — a real publish run from your own machine can't
# consume any of it, so it doesn't need to (and shouldn't) count against the
# same shared usage counter/lock that protects the actual Render deployment
# your friends use. Set this to "true" here, in your LOCAL .env only — never
# set it on Render itself (the default there is correctly "tracked").
DISABLE_BANDWIDTH_TRACKING=true
